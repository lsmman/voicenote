{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/((?!(?:api|docs|\\.well-known)(?:/|$)|llms(?:-full)?\\.txt(?:/|$)).*)", "destination": "/index.html" }
  ]
}
