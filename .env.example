EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional override for web/native API origin. Unset: web uses same-origin;
# native uses https://voicenote-ten-alpha.vercel.app. Do not set empty on native.
# EXPO_PUBLIC_API_BASE=https://voicenote-ten-alpha.vercel.app

# Server-only Vercel environment variables; never prefix these with EXPO_PUBLIC_.
# Supabase is optional for summaries; configured signed-in users use the daily quota.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
ANTHROPIC_API_KEY=
# Max summaries per user per day
SUMMARY_DAILY_LIMIT=20

# Optional anonymous Origin/Referer allowlist (comma-separated origins).
# Unset defaults to https://<request host>; no-Origin requests need x-voicenote-client: app.
# ALLOWED_ORIGINS=https://voicenote-ten-alpha.vercel.app,http://localhost:8081
# Anonymous requests per IP in a sliding hour; per-instance, in-memory best effort.
# Serverless restarts reset limits and separate instances do not share counters.
ANON_SUMMARY_PER_HOUR=10
